<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>Posts on Mindaugas Urbontaitis</title><link>https://www.urbontaitis.lt/posts/</link><description>Recent content in Posts on Mindaugas Urbontaitis</description><generator>Hugo</generator><language>en</language><copyright>Mindaugas Urbontaitis</copyright><lastBuildDate>Wed, 05 Jul 2023 00:00:00 +0300</lastBuildDate><atom:link href="https://www.urbontaitis.lt/posts/index.xml" rel="self" type="application/rss+xml"/><item><title>Bike setup for The Bright Midnight 2023</title><link>https://www.urbontaitis.lt/posts/bike-the-bright-midnight-2023/</link><pubDate>Wed, 05 Jul 2023 00:00:00 +0300</pubDate><guid>https://www.urbontaitis.lt/posts/bike-the-bright-midnight-2023/</guid><description>&lt;h2 id="bike-setup-for-the-bright-midnight-2023-unsupported-bikepacking-race"&gt;Bike Setup for &lt;a href="https://www.bright-midnight.com/" class="external-link" target="_blank" rel="noopener noreferrer"&gt;The Bright Midnight 2023 &lt;i class="fa-solid fa-external-link" aria-hidden="true"&gt;&lt;/i&gt;&lt;span class="sr-only"&gt; external link&lt;/span&gt;&lt;/a&gt;&#10; unsupported bikepacking race:&lt;/h2&gt;&#10;&lt;table&gt;&#10;&#9;&lt;thead&gt;&#10;&#9;&#9;&#9;&lt;tr&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;th style="text-align: left"&gt;Frame&lt;/th&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;th style="text-align: right"&gt;8bar Mitte V3 - GRAVEL X ROAD&lt;/th&gt;&#10;&#9;&#9;&#9;&lt;/tr&gt;&#10;&#9;&lt;/thead&gt;&#10;&#9;&lt;tbody&gt;&#10;&#9;&#9;&#9;&lt;tr&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: left"&gt;Rims&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: right"&gt;Duke racing carbon wheels&lt;/td&gt;&#10;&#9;&#9;&#9;&lt;/tr&gt;&#10;&#9;&#9;&#9;&lt;tr&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: left"&gt;Hubs&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: right"&gt;SP PL-7, DT-Swiss 350&lt;/td&gt;&#10;&#9;&#9;&#9;&lt;/tr&gt;&#10;&#9;&#9;&#9;&lt;tr&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: left"&gt;Tyres&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: right"&gt;Pirelli Cinturato H 45mm&lt;/td&gt;&#10;&#9;&#9;&#9;&lt;/tr&gt;&#10;&#9;&#9;&#9;&lt;tr&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: left"&gt;Handlebars&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: right"&gt;Ritchey WCS VentureMax v2 Handlebar / Brooks Cambium Rubber Bar Tape&lt;/td&gt;&#10;&#9;&#9;&#9;&lt;/tr&gt;&#10;&#9;&#9;&#9;&lt;tr&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: left"&gt;Crankset&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: right"&gt;Shimano GRX - Gravel Crankset - 2x11 (48/32T)&lt;/td&gt;&#10;&#9;&#9;&#9;&lt;/tr&gt;&#10;&#9;&#9;&#9;&lt;tr&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: left"&gt;Pedals&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: right"&gt;Shimano XTR PD-M9100&lt;/td&gt;&#10;&#9;&#9;&#9;&lt;/tr&gt;&#10;&#9;&#9;&#9;&lt;tr&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: left"&gt;Cassette&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: right"&gt;Shimano XT CS-M8000 11-40&lt;/td&gt;&#10;&#9;&#9;&#9;&lt;/tr&gt;&#10;&#9;&#9;&#9;&lt;tr&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: left"&gt;Derailleur&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: right"&gt;Shimano RD-RX810 + Wolftooth RoadLink DM&lt;/td&gt;&#10;&#9;&#9;&#9;&lt;/tr&gt;&#10;&#9;&#9;&#9;&lt;tr&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: left"&gt;Brakes&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: right"&gt;Shimano BR-RX810&lt;/td&gt;&#10;&#9;&#9;&#9;&lt;/tr&gt;&#10;&#9;&#9;&#9;&lt;tr&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: left"&gt;Shifters&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: right"&gt;Shimano ST-RX810&lt;/td&gt;&#10;&#9;&#9;&#9;&lt;/tr&gt;&#10;&#9;&#9;&#9;&lt;tr&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: left"&gt;Saddle&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: right"&gt;Brooks C13 Carved 145 All Weather&lt;/td&gt;&#10;&#9;&#9;&#9;&lt;/tr&gt;&#10;&#9;&#9;&#9;&lt;tr&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: left"&gt;Seatpost&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: right"&gt;8bar GIGA Seatpost&lt;/td&gt;&#10;&#9;&#9;&#9;&lt;/tr&gt;&#10;&#9;&#9;&#9;&lt;tr&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: left"&gt;Steam&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: right"&gt;Ritchey WCS C220 84D Stem&lt;/td&gt;&#10;&#9;&#9;&#9;&lt;/tr&gt;&#10;&#9;&#9;&#9;&lt;tr&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: left"&gt;Aerobars&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: right"&gt;Profile Design + 30 mm Bracket Riser&lt;/td&gt;&#10;&#9;&#9;&#9;&lt;/tr&gt;&#10;&#9;&#9;&#9;&lt;tr&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: left"&gt;Lights&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: right"&gt;K-lite Road light with low drag 700lm - no need for Gravel light 1300lm. Rear: Garmin Varia RTL510/515&lt;/td&gt;&#10;&#9;&#9;&#9;&lt;/tr&gt;&#10;&#9;&#9;&#9;&lt;tr&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: left"&gt;Charger&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: right"&gt;kLite Dual USB Mount&lt;/td&gt;&#10;&#9;&#9;&#9;&lt;/tr&gt;&#10;&#9;&#9;&#9;&lt;tr&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: left"&gt;Frame bag&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: right"&gt;Ride And Get Lost (custom bag)&lt;/td&gt;&#10;&#9;&#9;&#9;&lt;/tr&gt;&#10;&#9;&#9;&#9;&lt;tr&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: left"&gt;Top Tube bag&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: right"&gt;Restrap Look Race Top Tube Bag - Limited Run 04&lt;/td&gt;&#10;&#9;&#9;&#9;&lt;/tr&gt;&#10;&#9;&lt;/tbody&gt;&#10;&lt;/table&gt;&#10;&lt;h2 id="items"&gt;Items&lt;/h2&gt;&#10;&lt;h3 id="frame-bag"&gt;Frame bag&lt;/h3&gt;&#10;&lt;figure&gt;&lt;img src="https://www.urbontaitis.lt/posts/bike-the-bright-midnight-2023/images/IMG_3191.JPG"&#10;&#9;&#9;&#9;alt="Frame bag"&gt;&#10;&lt;/figure&gt;&#10;&#10;&lt;h3 id="rear-bag"&gt;Rear bag&lt;/h3&gt;&#10;&lt;figure&gt;&lt;img src="https://www.urbontaitis.lt/posts/bike-the-bright-midnight-2023/images/IMG_3192.JPG"&#10;&#9;&#9;&#9;alt="Rear bag"&gt;&#10;&lt;/figure&gt;&#10;&#10;&lt;h3 id="on-me-"&gt;On me 😄&lt;/h3&gt;&#10;&lt;figure&gt;&lt;img src="https://www.urbontaitis.lt/posts/bike-the-bright-midnight-2023/images/IMG_3193.JPG"&#10;&#9;&#9;&#9;alt="Frame bag"&gt;&#10;&lt;/figure&gt;&#10;&#10;&lt;p&gt;Follow me during the race (cap number 141): &lt;a href="https://www.followmychallenge.com/live/bm23/" class="external-link" target="_blank" rel="noopener noreferrer"&gt;followmychallenge.com/live/bm23 &lt;i class="fa-solid fa-external-link" aria-hidden="true"&gt;&lt;/i&gt;&lt;span class="sr-only"&gt; external link&lt;/span&gt;&lt;/a&gt;&#10; or check my IG stories: &lt;a href="https://www.instagram.com/m.urbo/" class="external-link" target="_blank" rel="noopener noreferrer"&gt;@m.urbo &lt;i class="fa-solid fa-external-link" aria-hidden="true"&gt;&lt;/i&gt;&lt;span class="sr-only"&gt; external link&lt;/span&gt;&lt;/a&gt;&#10;&lt;/p&gt;</description></item><item><title>Brevet 600 - Kintai</title><link>https://www.urbontaitis.lt/posts/2023-brevet-600/</link><pubDate>Mon, 26 Jun 2023 00:00:00 +0300</pubDate><guid>https://www.urbontaitis.lt/posts/2023-brevet-600/</guid><description>&lt;h2 id="paris---brest---paris-2023-kvalifikacija"&gt;Paris - Brest - Paris 2023 kvalifikacija&lt;/h2&gt;&#10;&lt;p&gt;Brevet 600 yra paskutinis kvalifikacinis važiavimas iš 200, 300, 400 ir 600km serijos norintiems dalyvauti seniausiame dviračių renginyje Paris - Brest - Paris (PBP). Šiais metais vyks 27 kartą nuo 1891 metų. PBP sudaro 1200km ir 12000 metrų sukilimo, kuriame dalyvauja ~8000 dalyvių iš viso pasaulio ir jis vyksta kas ketverius metus. 2019 metais turėjau galimybę sudalyvauti ir pats bei visą distanciją įveikiau per 75h:&lt;/p&gt;</description></item></channel></rss>